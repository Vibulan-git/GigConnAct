{
  "hosting": {
    "public": ".",
    "ignore": [
      "node-portable/**",
      "node-portable/**/*",
      "**/node-portable/**",
      "node-temp/**",
      "node-temp/**/*",
      "**/node-temp/**",
      "functions/**",
      "functions",
      "firebase.json",
      ".git/**",
      ".git/**/*",
      ".git",
      "**/.git/**",
      "**/.*",
      "**/node_modules/**",
      "*.ps1",
      "README.md",
      "CNAME",
      "firebase.exe",
      "firebase-tools-instant-win.exe"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "**/*.@(js|html|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico|mp4)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
