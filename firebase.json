{
  "hosting": {
    "public": ".",
    "ignore": [
      "node-portable/**",
      "node-portable/**/*",
      "**/node-portable/**",
      "node-temp/**",
      "node-temp/**/*",
      "**/node-temp/**",
      "functions/**",
      "functions",
      "firebase.json",
      ".git/**",
      ".git/**/*",
      ".git",
      "**/.git/**",
      "**/.*",
      "**/node_modules/**",
      "*.ps1",
      "README.md",
      "CNAME",
      "firebase.exe",
      "firebase-tools-instant-win.exe"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
